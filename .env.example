# PostgreSQL
# POSTGRES_HOST/POSTGRES_PORT are what `api`/`worker`/the one-shot `migrate`
# service use to reach Postgres *inside* the Docker network (STORY-023) -
# "postgres" (the Docker Compose service name) and 5432 (Postgres's own
# internal port), never "localhost" between containers (brief §26). The
# host machine can still reach this same Postgres directly at
# localhost:5433 (see docker-compose.yml's ports:) - that mapping is a
# separate, host-only convenience and is not read from this file.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=visibility
POSTGRES_USER=visibility
POSTGRES_PASSWORD=visibility

# Redis
# Same service-name note as above applies here - the host can still reach
# Redis directly at localhost:6379 (docker-compose.yml's ports:).
REDIS_HOST=redis
REDIS_PORT=6379

# OpenRouter (AI provider - replaces the original brief's local Ollama/Qwen3:4b)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# EPIC-13 (KAD-24) - a distinct free-tier model from OPENROUTER_MODEL,
# used only by the prompt-answering/ranking step (STORY-046), never by
# prompt generation (STORY-043, which uses OPENROUTER_MODEL). Deliberately
# different from OPENROUTER_MODEL so the same model never "knows" its own
# generated prompts' intent while answering them.
OPENROUTER_ANSWER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Rust analyzer service (EPIC-06). Same service-name note as POSTGRES_HOST/
# REDIS_HOST above - "analyzer" is the Docker Compose service name, per the
# brief's §26 inter-service networking note.
ANALYZER_URL=http://analyzer:8080

# Next.js frontend. Unlike ANALYZER_URL above, this is NOT a Docker-network
# service name - every API call the frontend makes happens in the user's
# browser, not inside the frontend container, so it must be a URL the host
# machine can resolve: the api service's host-published port (localhost:3000),
# never "api:3000". Baked into the client bundle at build time (Next.js
# inlines every NEXT_PUBLIC_* var when `next build` runs) - changing this
# requires rebuilding the frontend image, not just restarting the container.
NEXT_PUBLIC_API_URL=http://localhost:3000
