# PostgreSQL
# NOTE: apps/api and apps/worker still run directly on the host at this
# stage (they are only dockerized in STORY-023 / EPIC-09). While that's
# true, POSTGRES_HOST must be "localhost" so the host process can reach
# the Dockerized Postgres container via its published port. Once api/worker
# themselves run inside Docker Compose, this must change to the Docker
# service name "postgres" instead - never "localhost" between containers.
# POSTGRES_PORT is 5433 (not the default 5432) here because a different,
# unrelated Postgres install may already be running on the host machine's
# 5432 - once api/worker move inside Docker Compose (STORY-023), this
# should become 5432 again, since containers reach each other over the
# private Docker network, not through this host-only published port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=visibility
POSTGRES_USER=visibility
POSTGRES_PASSWORD=visibility

# Redis
# Same localhost-vs-service-name note as above applies here.
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenRouter (AI provider - replaces the original brief's local Ollama/Qwen3:4b)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Rust analyzer service (EPIC-06). Same localhost-vs-service-name note as
# POSTGRES_HOST/REDIS_HOST above applies here - this becomes
# http://analyzer:8080 (the Docker Compose service name) once STORY-023
# dockerizes api/worker, per the brief's §26 inter-service networking note.
ANALYZER_URL=http://localhost:8080
