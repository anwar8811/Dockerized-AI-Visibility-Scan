# PostgreSQL
# NOTE: apps/api and apps/worker still run directly on the host at this
# stage (they are only dockerized in STORY-023 / EPIC-09). While that's
# true, POSTGRES_HOST must be "localhost" so the host process can reach
# the Dockerized Postgres container via its published port. Once api/worker
# themselves run inside Docker Compose, this must change to the Docker
# service name "postgres" instead - never "localhost" between containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=visibility
POSTGRES_USER=visibility
POSTGRES_PASSWORD=visibility

# Redis
# Same localhost-vs-service-name note as above applies here.
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenRouter (AI provider - replaces the original brief's local Ollama/Qwen3:4b)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
